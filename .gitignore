pipeline_output/dead_letter.json

# Dataset files (exclude large files from Git)
data/processed/*.csv
data/raw/*.csv
outputs/*.csv
pipeline_output/bq_exports/*.csv

# Keep directory structure but ignore files inside
!data/processed/.gitkeep
!data/raw/.gitkeep
!outputs/.gitkeep
!pipeline_output/bq_exports/.gitkeep
